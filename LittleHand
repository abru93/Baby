<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Waiting for Our Baby</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Poppins',sans-serif}
body{
height:100vh;display:flex;justify-content:center;align-items:center;overflow:hidden;
background:linear-gradient(135deg,#FFF9FB,#FFF5F7,#FDF6FF,#F8FBFF,#FFFDF6);
background-size:400% 400%;animation:gradientMove 18s ease infinite;position:relative}
@keyframes gradientMove{0%{background-position:0 50%}50%{background-position:100% 50%}100%{background-position:0 50%}}
.bubble{position:absolute;border-radius:50%;filter:blur(3px);opacity:.45;animation:floatBubble ease-in-out infinite}
.b1{width:220px;height:220px;background:#FFE5EC;left:-60px;bottom:-60px;animation-duration:22s}
.b2{width:170px;height:170px;background:#EAF7FF;right:-40px;top:8%;animation-duration:26s}
.b3{width:120px;height:120px;background:#FFF4D6;left:20%;top:15%;animation-duration:20s}
.b4{width:190px;height:190px;background:#F5E9FF;right:18%;bottom:-70px;animation-duration:28s}
.b5{width:140px;height:140px;background:#E8FFF5;left:70%;top:55%;animation-duration:24s}
.b6{width:90px;height:90px;background:#FFEFD8;left:8%;top:60%;animation-duration:18s}
@keyframes floatBubble{0%{transform:translateY(40px) scale(1)}50%{transform:translateY(-35px) scale(1.08)}100%{transform:translateY(40px) scale(1)}}
.card{
width:90%;max-width:460px;background:rgba(255,255,255,.72);backdrop-filter:blur(18px);
border:1px solid rgba(255,255,255,.8);border-radius:30px;padding:35px;text-align:center;
box-shadow:0 15px 40px rgba(255,182,193,.18);color:#555}
h1{font-size:2rem;color:#d46a8c;margin-bottom:8px}
.subtitle{color:#777;margin-bottom:20px}
.big{font-size:54px;font-weight:700;color:#ff6f91}
.progress-container{width:100%;height:18px;background:#f0f0f0;border-radius:20px;overflow:hidden;margin:18px 0}
.progress{height:100%;width:0;background:linear-gradient(90deg,#FFB6C1,#FFD6A5,#CDEAC0,#B5EAD7);transition:1s}
#percent{font-weight:600;color:#888}
.info{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:20px}
.box{background:rgba(255,255,255,.6);padding:16px;border-radius:18px}
.box h3{font-size:.9rem;color:#888;margin-bottom:6px}
.box p{font-size:1.25rem;font-weight:700;color:#555}
.footer{margin-top:20px;color:#777}
.heart{display:inline-block;animation:pulse 1.5s infinite}
@keyframes pulse{50%{transform:scale(1.2)}}
</style>
</head>
<body>
<div class="bubble b1"></div><div class="bubble b2"></div><div class="bubble b3"></div>
<div class="bubble b4"></div><div class="bubble b5"></div><div class="bubble b6"></div>

<div class="card">
<h1>👶 Waiting for Our Baby</h1>
<div class="subtitle">Every heartbeat brings us closer to meeting you ❤️</div>
<div class="big" id="remaining">0</div>
<div>Days Remaining</div>

<div class="progress-container"><div class="progress" id="progress"></div></div>
<div id="percent">0%</div>

<div class="info">
<div class="box"><h3>Pregnancy Week</h3><p id="week">0</p></div>
<div class="box"><h3>Days Passed</h3><p id="passed">0</p></div>
<div class="box"><h3>Total Days</h3><p id="total">274</p></div>
<div class="box"><h3>Due Date</h3><p style="font-size:18px">10 Aug 2026</p></div>
</div>

<div class="footer"><span class="heart">💖</span> Counting every moment until we hold you in our arms.</div>
</div>

<script>
const pregnancyDate=new Date("2025-11-09");
const dueDate=new Date("2026-08-10");

function update(){
const today=new Date();
const totalDays=Math.ceil((dueDate-pregnancyDate)/86400000);
const passedDays=Math.max(0,Math.floor((today-pregnancyDate)/86400000));
const remaining=Math.ceil((dueDate-today)/86400000);
const progress=Math.min(100,Math.max(0,passedDays/totalDays*100));
const week=Math.floor(passedDays/7);
const day=passedDays%7;
document.getElementById("remaining").textContent=remaining>0?remaining:"🎉";
document.getElementById("week").textContent=week+"W "+day+"D";
document.getElementById("passed").textContent=passedDays;
document.getElementById("total").textContent=totalDays;
document.getElementById("progress").style.width=progress+"%";
document.getElementById("percent").textContent=progress.toFixed(1)+"% Completed";
}
update();
setInterval(update,1000);
</script>
</body>
</html>
